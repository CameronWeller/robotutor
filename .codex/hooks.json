{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$(git rev-parse --show-toplevel)/tools/claude-transcripts\" codex-hook",
            "timeout": 180
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$(git rev-parse --show-toplevel)/tools/claude-transcripts\" codex-hook",
            "timeout": 180
          }
        ],
        "matcher": "Bash|apply_patch|Edit|Write"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$(git rev-parse --show-toplevel)/tools/claude-transcripts\" codex-hook",
            "timeout": 180
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$(git rev-parse --show-toplevel)/tools/claude-transcripts\" codex-hook",
            "timeout": 180
          }
        ]
      }
    ]
  }
}
