+/// Read only earlier receipts for this introduction. A confirmed offer consumes the
+/// reminder, even when the learner leaves without taking the assessment.
+pub(super) fn pending(source: &intro_question::Receipt, visit: u32) -> Option<Request> {
+    for record in source.returns.iter().rev().filter(|r| r.visit < visit) {
+        let Some(pos) = record
+            .effects
+            .iter()
+            .rposition(|e| e["status"] == "flow_requested")
+        else {
+            continue;
+        };
+        let mut request = decode(&record.effects[pos]["decision"])?;
+        let after = &record.effects[pos + 1..];
+        match request.timing {
+            Timing::Reopened(_) if !after.iter().any(|e| e["status"] == "flow_offer_delivered") => {
+                continue
+            }
+            Timing::NextVisit if !after.iter().any(|e| e["status"] == "check_requested") => {
+                request.timing = Timing::Reopened(record.visit);
+                return Some(request);
+            }
+            _ => return None,
+        }
+    }
+    None
+}
