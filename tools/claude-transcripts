#!/bin/sh
# Run the Claude Code transcript archiver with whichever Python 3 this system provides.
here=$(cd "$(dirname "$0")" && pwd)
for python in python3 python; do
  if command -v "$python" >/dev/null 2>&1 && "$python" -c 'import sys; sys.exit(sys.version_info < (3, 9))' 2>/dev/null; then
    exec "$python" "$here/claude_transcripts.py" "$@"
  fi
done
echo "Python 3.9 or newer is required to archive Claude Code transcripts." >&2
exit 1
